# Local development: local. Production: github.
STORAGE_MODE=local
GITHUB_OWNER=KA71337
GITHUB_REPO=-My-Pixel
GITHUB_BRANCH=main
GITHUB_CATALOG_PATH=data/catalog.json
GITHUB_TOKEN=
# Strong unique password (at least 16 characters); never put in NEXT_PUBLIC variables.
ADMIN_PASSWORD=
# At least 32 random characters; changing it invalidates sessions.
SESSION_SECRET=
# Required for production admin: durable sessions and atomic login throttling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Actual deployment origin. Leave blank until known; no invented domain.
NEXT_PUBLIC_SITE_URL=
# Optional local data directory; default .local (not tracked).
LOCAL_DATA_DIR=
